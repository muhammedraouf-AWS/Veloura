HOST=0.0.0.0
PORT=1337

# Secrets — generate with: node -e "require('crypto').randomBytes(32).toString('base64')"
APP_KEYS="key1,key2,key3,key4"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Frontend (CORS allowlist)
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# Cloudinary (Phase 4.2)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CLOUDINARY_FOLDER=veloura

# Email — use Ethereal (https://ethereal.email) for dev, real SMTP for prod
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@veloura.com
EMAIL_REPLY_TO=support@veloura.com
